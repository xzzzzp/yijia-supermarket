# Supabase（生产环境推荐，配置后优先使用）
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 本地开发登录（未配置 Supabase 时生效）
ADMIN_DEV_EMAIL=admin@local.dev
ADMIN_DEV_PASSWORD=admin123

# 用局域网 IP 访问时填写（例：http://172.16.1.152:3000）
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Next.js 16 局域网 dev 访问需放行（多个 IP 用逗号分隔）
ALLOWED_DEV_ORIGINS=172.16.1.152,127.0.0.1,localhost
