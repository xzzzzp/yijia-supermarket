# MySQL。配置后订单、店员、商品、店铺设置写入该库。
# 也可以只填 MYSQL_URL（例：mysql://user:pass@127.0.0.1:3306/yijia）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=yijia
MYSQL_USER=yijia
MYSQL_PASSWORD=change-me
# MYSQL_URL=

# 后台会话签名。生产环境必须填写，不会回退到 ADMIN_DEV_PASSWORD。
# 本地开发未填写时，才用 ADMIN_DEV_PASSWORD 签名。
ADMIN_SESSION_SECRET=replace-with-a-long-random-string

# 未配置 MySQL 时，用这对账号登录，店员写在 data/staff.json。
# 已配置 MySQL 且 staff 表为空时，用这对账号登录才会创建第一名店主；写入失败不会登录成功。
# NODE_ENV=production 且未配置 MySQL 时，这对账号无效。
ADMIN_DEV_EMAIL=admin@local.dev
ADMIN_DEV_PASSWORD=admin123

# 子路径部署时填写，例如 /yijia。改完必须重新构建。
# NEXT_PUBLIC_BASE_PATH=/yijia

# 用局域网 IP 访问时填写（例：http://172.16.1.152:3000）
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Next.js 16 局域网 dev 访问需放行（多个 IP 用逗号分隔）
ALLOWED_DEV_ORIGINS=172.16.1.152,127.0.0.1,localhost

# 可选：下单成功后用 Telegram Bot 通知店铺。未配置时订单仍会保存。
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
