# 生产环境变量。复制到应用目录的 .env.local，填好真实值后再 npm run build。
# 先在 MySQL 执行 mysql/schema.sql，再填写连接。不要把真实密码提交到仓库。
# .env.local 已被 .gitignore 忽略。deploy/deploy.sh 的 rsync 排除该文件，且未使用
# --delete-excluded，所以 --delete 不会覆盖或删除服务器上已有的 .env.local。
#
# 必填（占位符必须换成生产值）：
# - MYSQL_HOST、MYSQL_DATABASE、MYSQL_USER（以及 MYSQL_PASSWORD / MYSQL_PORT），或改用 MYSQL_URL
# - ADMIN_SESSION_SECRET（长随机串，用于签发后台会话）
# - ADMIN_DEV_EMAIL 与 ADMIN_DEV_PASSWORD（staff 表为空时创建第一名店主，必须成对）
# - NEXT_PUBLIC_BASE_PATH=/yijia
# - NEXT_PUBLIC_SITE_URL（对外地址，例如 http://<主机>/yijia）
# - ALLOWED_DEV_ORIGINS（逗号分隔的主机名）
#
# /admin/login 在 next build 时预渲染。build 时若没有 MySQL 配置，且没有成对的
# ADMIN_DEV_EMAIL + ADMIN_DEV_PASSWORD，静态页会写成 authMode=none，登录页出现
# 黄框「尚未配置登录方式」。Next 在 build 时读取这份 .env.local（PM2 只传 NODE_ENV 和 PORT）。
# 事后补上 .env.local 再 pm2 restart 不会更新已预渲染的登录页，必须带齐变量重新 npm run build。
# deploy/check-env.sh 会在 build 前检查，缺登录变量则失败退出。
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=yijia
MYSQL_USER=yijia
MYSQL_PASSWORD=change-me

ADMIN_SESSION_SECRET=replace-with-a-long-random-string

# staff 表为空时，用下面的邮箱和密码创建第一名店主
ADMIN_DEV_EMAIL=admin@local.dev
ADMIN_DEV_PASSWORD=admin123

# 通过 80 端口 /yijia/ 路径访问（无需开放 8080）
NEXT_PUBLIC_BASE_PATH=/yijia
NEXT_PUBLIC_SITE_URL=http://47.84.229.230/yijia
ALLOWED_DEV_ORIGINS=47.84.229.230,127.0.0.1,localhost
