# 生产环境变量（复制为服务器上的 .env.local 后填入真实值）
# 先在 MySQL 执行 mysql/schema.sql。不要把真实密码提交到仓库。
# deploy.sh 会拒绝下面的占位符。

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=yijia
MYSQL_USER=yijia
MYSQL_PASSWORD=change-me

# 生产环境签发会话必须用这项，不会回退到 ADMIN_DEV_PASSWORD。
ADMIN_SESSION_SECRET=replace-with-a-long-random-string

# staff 表为空时，用下面的邮箱和密码创建第一名店主。请改掉示例值。
ADMIN_DEV_EMAIL=admin@local.dev
ADMIN_DEV_PASSWORD=admin123

# 通过 80 端口 /yijia/ 访问。此变量在 next build 时打进前端，修改后必须重新构建。
NEXT_PUBLIC_BASE_PATH=/yijia
NEXT_PUBLIC_SITE_URL=http://47.84.229.230/yijia
ALLOWED_DEV_ORIGINS=47.84.229.230,127.0.0.1,localhost

# 可选：店铺 Telegram 通知。未配置时订单仍会保存。
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# HTTPS 需在有域名和证书后单独配置（certbot）。配好后把 NEXT_PUBLIC_SITE_URL 改成 https 并重新构建。
